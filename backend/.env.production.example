# MongoDB
MONGO_URL=mongodb://mongodb:27017
DB_NAME=email_verifier_db

# Redis
REDIS_URL=redis://redis:6379/0

# JWT - CHANGE THIS IN PRODUCTION
SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-STRING-IN-PRODUCTION

# Email (Gmail SMTP) - Update with your credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Email Verifier API
EMAIL_VERIFIER_API=https://your-email-verifier-api.com
EMAIL_VERIFIER_API_FALLBACK=http://158.69.113.127:8080

# Razorpay - LIVE KEYS (Keep secure!)
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# CORS
CORS_ORIGINS=https://yourdomain.com

# App
APP_NAME=MailGuard - Email Verifier
APP_URL=https://yourdomain.com